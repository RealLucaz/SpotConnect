{
  "schemaVersion": 1,
  "id": "spotconnect",
  "version": "${version}",
  "name": "SpotConnect Premium",
  "description": "Play your Spotify Premium library from inside Minecraft. Requires a Spotify Premium account. Playback runs in a dedicated hidden Chrome profile signed in to the official Spotify Web Player, driven through the official Spotify Web API.",
  "authors": [
    "lucaz"
  ],
  "icon": "assets/spotconnect/icon.png",
  "license": "MIT",
  "contact": {
    "sources": "https://github.com/RealLucaz/spotconnect",
    "issues": "https://github.com/RealLucaz/spotconnect/issues"
  },
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.lucaz.spotconnect.SpotConnectClient"
    ],
    "modmenu": [
      "com.lucaz.spotconnect.compat.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
